# Set unique random values, at least 24 characters each. Never add VITE_ API secrets.
CASH_API_KEY=
CASH_UI_PASSWORD=
CASH_UI_USER=reviewer
CASH_DATA_DIR=./runtime
# Disabled mode serves UI/API diagnostics but NEVER returns simulated analysis.
CASH_MODEL_ENABLED=false
CASH_MODEL_PATH=./models/Qwen3-VL-4B-Instruct
CASH_LORA_PATH=
CASH_DEVICE=cuda:0
CASH_JOB_TIMEOUT_SEC=290
CASH_QUEUE_CAPACITY=3
CASH_MAX_UPLOAD_MB=100
CASH_OVERVIEW_FPS=1
CASH_MAX_OVERVIEW_FRAMES=145
CASH_MAX_DETAIL_FRAMES=24
CASH_MAX_CANDIDATES=6
CASH_MAX_VISUAL_TOKENS=20000
CASH_MAX_INPUT_TOKENS=28000
CASH_FRAME_MAX_PIXELS=131072
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# Detail images retain more pixels; sparse context still spans the entire clip.
CASH_CONTEXT_FRAME_COUNT=24
CASH_AUDIT_FRAME_COUNT=32
CASH_DETAIL_FRAME_MAX_PIXELS=524288
# Native video mode is experimental until evaluated on the deployment host.
CASH_QWEN_INPUT_MODE=images
CASH_QWEN_DISCOVERY_STYLE=narrative
# Optional PRIVATE generic guidance JSON, never an answer-key table.
CASH_CALIBRATION_PROFILE_PATH=
